# Public hostname dedicated to Automation-Content Hub.
DOMAIN=content-hub.example.com

# MCP Host header allowlist. Include bare host and host with any port.
MCP_ALLOWED_HOSTS=content-hub.example.com,content-hub.example.com:*

# Keep empty: this Hub currently serves agent MCP clients, not browser-based MCP clients.
MCP_ALLOWED_ORIGINS=

# Optional email used by Caddy for ACME certificate registration.
ACME_EMAIL=admin@example.com
